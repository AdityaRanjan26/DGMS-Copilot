# DGMS Copilot Backend — Environment Configuration
# Copy this file to .env and fill in your values.

# ─────────────────────────────────────────────
# REQUIRED: Google Gemini API key
# Ollama configuration (default: qwen3:8b, fallback: llama3.1:8b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_FALLBACK_MODEL=llama3.1:8b

# Path to the Vector Store persistent directory (relative to backend/)
# VECTOR_DB_PATH=../vector_db

# Path to the documents directory (relative to backend/)
# DOCUMENTS_PATH=../documents

# Collection name in Vector Store
# VECTOR_COLLECTION=dgms_corpus

# Number of chunks to retrieve per query
# RETRIEVAL_TOP_K=5

# Minimum similarity score (0.0–1.0) — chunks below this are filtered out
# RETRIEVAL_SCORE_THRESHOLD=0.35
